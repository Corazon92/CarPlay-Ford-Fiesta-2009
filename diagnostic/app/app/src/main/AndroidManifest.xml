<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lecture seule. Aucune permission d'écriture véhicule, aucun accès réseau. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Nécessaire (Android 11+) pour voir les packages système ; installation hors Play Store uniquement. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:label="Fiesta Diag"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Service vide : une fois activé par l'utilisateur (Accès aux notifications), il autorise
             MediaSessionManager.getActiveSessions(). Aucune notification n'est lue. -->
        <service
            android:name=".DiagListenerService"
            android:exported="true"
            android:label="Fiesta Diag (sessions média)"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
